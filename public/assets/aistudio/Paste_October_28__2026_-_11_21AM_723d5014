/**
 * Laurence Magondu Portfolio Setup
 * Core Interface Logic, Native Theme Pipeline, Calculators & Conversion Routing
 */

document.addEventListener('DOMContentLoaded', () => {

  // 1. Unified Light & Dark Theme Configuration Pipeline
  const themeToggleBtn = document.getElementById('theme-toggle');
  const storedTheme = localStorage.getItem('laurence-portfolio-theme') || 'dark';

  if (storedTheme === 'light') {
    document.body.classList.add('light-theme');
  }

  themeToggleBtn.addEventListener('click', () => {
    document.body.classList.toggle('light-theme');
    const activeTheme = document.body.classList.contains('light-theme') ? 'light' : 'dark';
    localStorage.setItem('laurence-portfolio-theme', activeTheme);
  });

  // 2. Responsive Mobile Navigation Toggle Menu System
  const navToggle = document.querySelector('.mobile-nav-toggle');
  const mainNav = document.querySelector('.main-navigation');
  const navLinks = document.querySelectorAll('.nav-links a');

  navToggle.addEventListener('click', () => {
    const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
    navToggle.setAttribute('aria-expanded', !isExpanded);
    mainNav.classList.toggle('active');
  });

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      navToggle.setAttribute('aria-expanded', 'false');
      mainNav.classList.remove('active');
    });
  });

  // 3. Interactive Operations Cost Leakage & ROI Calculator Engine
  const hoursRange = document.getElementById('hours-range');
  const rateRange = document.getElementById('rate-range');
  const hoursDisplay = document.getElementById('hours-display');
  const rateDisplay = document.getElementById('rate-display');
  const leakageDisplay = document.getElementById('leakage-kes');
  const savingsDisplay = document.getElementById('savings-kes');

  function calculateOperationalLeakage() {
    const hours = parseInt(hoursRange.value);
    const rate = parseInt(rateRange.value);
    
    hoursDisplay.textContent = `${hours} hrs`;
    rateDisplay.textContent = `KES ${rate.toLocaleString()}/hr`;

    // 52 weeks in a year
    const annualLeakage = hours * rate * 52;
    const automatedSavings = Math.floor(annualLeakage * 0.75);

    leakageDisplay.textContent = `KES ${annualLeakage.toLocaleString()} / year`;
    savingsDisplay.textContent = `KES ${automatedSavings.toLocaleString()} saved/yr`;
  }

  hoursRange.addEventListener('input', calculateOperationalLeakage);
  rateRange.addEventListener('input', calculateOperationalLeakage);
  calculateOperationalLeakage(); // Initial Trigger

  // 4. Indicative Custom Project Scope & Budget Calculator Engine
  const calcCheckboxes = document.querySelectorAll('.calc-cb');
  const calcTotalDisplay = document.getElementById('calc-total');
  const calcDurationDisplay = document.getElementById('calc-duration');
  const currencyToggleBtn = document.getElementById('currency-toggle');
  const applyScopeBtn = document.getElementById('calc-apply-btn');
  const formTextArea = document.getElementById('project-scope');

  let activeCurrency = 'KES'; // Default baseline
  const KES_TO_USD_RATE = 130; // Stable reference conversion

  function processScopeSum() {
    let baseKESSum = 0;
    let maximumDays = 0;

    calcCheckboxes.forEach(cb => {
      if (cb.checked) {
        baseKESSum += parseInt(cb.getAttribute('data-kes'));
        maximumDays += parseInt(cb.getAttribute('data-days'));
      }
    });

    if (activeCurrency === 'KES') {
      calcTotalDisplay.textContent = `KES ${baseKESSum.toLocaleString()}`;
    } else {
      const usdValue = Math.ceil(baseKESSum / KES_TO_USD_RATE);
      calcTotalDisplay.textContent = `$${usdValue.toLocaleString()} USD`;
    }

    calcDurationDisplay.textContent = `${maximumDays} Estimated Business Days`;
  }

  calcCheckboxes.forEach(cb => cb.addEventListener('change', processScopeSum));

  currencyToggleBtn.addEventListener('click', () => {
    activeCurrency = activeCurrency === 'KES' ? 'USD' : 'KES';
    currencyToggleBtn.textContent = activeCurrency === 'KES' ? 'Switch to USD ($)' : 'Switch to KES (KSh)';
    processScopeSum();
  });

  applyScopeBtn.addEventListener('click', () => {
    let chosenFeatures = [];
    calcCheckboxes.forEach(cb => {
      if (cb.checked) {
        chosenFeatures.push(cb.getAttribute('data-name'));
      }
    });

    if (chosenFeatures.length === 0) {
      alert('Please check at least one requirement deliverable from the matrices above first.');
      return;
    }

    formTextArea.value = `Hello Laurence,\n\nI have evaluated my project needs using your scope estimator and want to lock in the following configuration:\n- ${chosenFeatures.join('\n- ')}\n\nPlease provide a structured project proposal.`;
    
    // Smooth scroll straight down to the configured contact card
    document.getElementById('contact').scrollIntoView({ behavior: 'smooth' });
  });

  // 5. Modular FAQ Accordion System
  const faqTriggers = document.querySelectorAll('.faq-trigger');

  faqTriggers.forEach(trigger => {
    trigger.addEventListener('click', () => {
      const parentItem = trigger.parentElement;
      const isOpen = parentItem.classList.contains('active');
      
      // Close other active drawers safely
      document.querySelectorAll('.faq-item').forEach(item => item.classList.remove('active'));

      if (!isOpen) {
        parentItem.classList.add('active');
      }
    });
  });

  // 6. Conversion Interface Formatting & Safe Form Submission Fallback
  const inquiryForm = document.getElementById('portfolio-inquiry-form');

  inquiryForm.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const clientName = document.getElementById('client-name').value;
    const clientEmail = document.getElementById('client-email').value;
    const projectDescription = formTextArea.value;

    const emailSubject = encodeURIComponent(`Project Brief System Submission from ${clientName}`);
    const emailBody = encodeURIComponent(
      `Structured Project Inquiry\n` +
      `==========================\n` +
      `Client Identity: ${clientName}\n` +
      `Return Channel: ${clientEmail}\n\n` +
      `Scope Parameters:\n${projectDescription}`
    );

    // Reliable native client fallback to avoid form intercept drop errors
    window.location.href = `mailto:laurencemureithi1999@://gmail.com{emailSubject}&body=${emailBody}`;
  });
});

